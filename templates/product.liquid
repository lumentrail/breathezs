<header style="background:var(--cream);border-bottom:1px solid var(--line)">
  <div class="container" style="display:flex;align-items:center;justify-content:space-between;padding-top:16px;padding-bottom:16px">
    <a href="/" aria-label="BreathEZs home"><img src="{{ 'logo.png' | asset_url }}" alt="BEZ BreathEZs logo" style="height:42px;width:auto;display:block"></a>
    <a href="/#collection" style="color:var(--purple);font-weight:600;text-decoration:none">&larr; Back to shop</a>
  </div>
</header>

<section class="pdp">
  <div class="container pdp-grid">
    <div class="pdp-gallery">
      {% if product.featured_image %}
        <img class="pdp-main" id="pdp-main" src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.featured_image.alt | escape | default: product.title }}">
      {% endif %}
      {% if product.images.size > 1 %}
        <div class="pdp-thumbs">
          {% for image in product.images %}
            <button type="button" class="pdp-thumb" data-src="{{ image | image_url: width: 900 }}" aria-label="View image {{ forloop.index }}">
              <img src="{{ image | image_url: width: 160 }}" alt="" loading="lazy">
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="pdp-info">
      <h1>{{ product.title }}</h1>
      <div class="pdp-price">{{ product.price | money }}</div>

        <form action="/cart/add" method="post" class="pdp-form">
          {% if product.variants.size > 1 %}
            <label class="pdp-field">
              <span>Choose an option</span>
              <select name="id">
                {% for variant in product.variants %}
                  <option value="{{ variant.id }}"{% unless variant.available %} disabled{% endunless %}>
                    {{ variant.title }}{% unless variant.available %} — sold out{% endunless %}
                  </option>
                {% endfor %}
              </select>
            </label>
          {% else %}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          {% endif %}
          <button type="submit" class="btn btn-primary pdp-add"{% unless product.available %} disabled{% endunless %}>
            {% if product.available %}Add to Cart{% else %}Sold Out{% endif %}
          </button>
        </form>

      {% if product.description != blank %}
        <div class="pdp-desc rte">{{ product.description }}</div>
      {% endif %}
    </div>
  </div>
</section>

<footer style="background:var(--ink);color:#fff;padding:26px 0">
  <div class="container" style="text-align:center;font-size:.92rem;color:rgba(255,255,255,.75)">
    © 2026 BreathEZs®. All Rights Reserved. &middot; <a href="mailto:customerservice@breathezs.com" style="color:var(--purple-neon);text-decoration:underline">customerservice@breathezs.com</a>
  </div>
</footer>

<script>
(function(){
  var main = document.getElementById('pdp-main');
  document.querySelectorAll('.pdp-thumb').forEach(function(t){
    t.addEventListener('click', function(){ if(main) main.src = t.getAttribute('data-src'); });
  });
})();
</script>
