<div class="auth">
  <a href="/" class="auth-logo" aria-label="BreathEZs home">
    <img src="{{ 'logo.png' | asset_url }}" alt="BEZ BreathEZs">
  </a>

  <div class="auth-card">
    <h1>Create your account</h1>
    <p class="auth-sub">Join BreathEZs for faster checkout and order tracking.</p>
    {% form 'create_customer' %}
      {% if form.errors %}
        <div class="auth-errors">{{ form.errors | default_errors }}</div>
      {% endif %}
      <div class="auth-field">
        <label for="reg-first">First name</label>
        <input type="text" name="customer[first_name]" id="reg-first" autocomplete="given-name">
      </div>
      <div class="auth-field">
        <label for="reg-last">Last name</label>
        <input type="text" name="customer[last_name]" id="reg-last" autocomplete="family-name">
      </div>
      <div class="auth-field">
        <label for="reg-email">Email</label>
        <input type="email" name="customer[email]" id="reg-email" autocomplete="email" required>
      </div>
      <div class="auth-field">
        <label for="reg-pass">Password</label>
        <input type="password" name="customer[password]" id="reg-pass" autocomplete="new-password" required>
      </div>
      <button type="submit" class="btn btn-primary">Create account</button>
    {% endform %}
    <p class="auth-alt">Already have an account? <a href="/account/login">Log in</a></p>
    <p class="auth-back"><a href="/">&larr; Back to store</a></p>
  </div>
</div>
