{% if settings.store_mode == 'buy' %}
<div class="cart-overlay" id="cart-overlay"></div>
<aside class="cart-drawer" id="cart-drawer" aria-label="Shopping cart" aria-hidden="true">
  <div class="cart-head">
    <h2>Your Cart</h2>
    <button type="button" class="cart-close" id="cart-close" aria-label="Close cart">&times;</button>
  </div>
  <div class="cart-items" id="cart-items"></div>
  <div class="cart-foot">
    <div class="cart-subtotal-row"><span>Subtotal</span><span id="cart-subtotal"></span></div>
    <a href="/checkout" class="btn btn-primary cart-checkout" id="cart-checkout">Checkout</a>
    <p class="cart-note">Shipping &amp; taxes calculated at checkout.</p>
  </div>
</aside>
{% endif %}

{% section 'footer' %}

<script>
// Shop links currently scroll to the on-page #collection section.
// When the storefront is finalized (e.g. this page becomes a Shopify
// Liquid theme), give the shop links the class "store-link" and set
// STORE_URL, and every one of them will point to the store.
var STORE_URL = "https://breathezs.myshopify.com";
document.querySelectorAll("a.store-link").forEach(function(a){ a.href = STORE_URL; });

// Tap to flip products between the front and the open-rear view.
// Works on touch (where hover does not) and as a sticky toggle on desktop.
document.querySelectorAll('.product .visual.flip').forEach(function(v){
  var cue = document.createElement('span');
  cue.className = 'flip-cue';
  cue.setAttribute('aria-hidden','true');
  cue.innerHTML = '&#8635;';
  v.appendChild(cue);
  var product = v.closest('.product');
  v.setAttribute('role','button');
  v.setAttribute('tabindex','0');
  v.setAttribute('aria-label','Flip to see the front and open-rear views');
  v.addEventListener('click', function(){ product.classList.toggle('flipped'); });
  v.addEventListener('keydown', function(e){
    if(e.key==='Enter'||e.key===' '){ e.preventDefault(); product.classList.toggle('flipped'); }
  });
});

// Color selector: swap the front and back images for the chosen colorway,
// keeping whatever face (front or back) is currently showing.
document.querySelectorAll('.product .swatches').forEach(function(group){
  var product = group.closest('.product');
  var visual = product.querySelector('.visual.flip');
  var front = visual.querySelector('.face.front');
  var back = visual.querySelector('.face.back');
  var nameEl = product.querySelector('.color-name');
  group.querySelectorAll('.swatch').forEach(function(sw){
    sw.addEventListener('click', function(){
      var c = sw.dataset.color;
      var cap = c.charAt(0).toUpperCase() + c.slice(1);
      front.src = visual.dataset['front' + cap];
      back.src  = visual.dataset['back' + cap];
      product.classList.remove('flipped');
      product.setAttribute('data-color', c);
      if (nameEl) nameEl.textContent = sw.dataset.name;
      group.querySelectorAll('.swatch').forEach(function(s){
        var on = s === sw;
        s.classList.toggle('is-active', on);
        s.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
    });
  });
});

// ---- Reservation picker -----------------------------------------------------
// The reserve form is a native Shopify {% raw %}{% form 'customer' %}{% endraw %},
// so it only persists email / first name / tags to the customer record. To make
// the style, color, and size land on the customer too (filterable in the
// Customers tab), we fold the picks into contact[tags] right before submit.
function bezSlug(s){ return String(s).toLowerCase().trim().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,''); }
document.querySelectorAll('.reserve-form').forEach(function(form){
  var styleSel = form.querySelector('[name="_style"]');
  var colorSel = form.querySelector('[name="_color"]');
  var sizeSel  = form.querySelector('[name="_size"]');
  var tagsInput = form.querySelector('input[name="contact[tags]"]');
  var nameInput = form.querySelector('input[name="contact[first_name]"]');
  var emailInput = form.querySelector('input[name="contact[email]"]');
  // Special Edition is black only: lock the color to match the style.
  function syncColor(){
    if(!styleSel || !colorSel) return;
    if(styleSel.value === 'Special Edition Black'){ colorSel.value = 'Black'; colorSel.disabled = true; }
    else { colorSel.disabled = false; }
  }
  if(styleSel){ styleSel.addEventListener('change', syncColor); syncColor(); }
  form.addEventListener('submit', function(){
    var picks = ['reserve','newsletter','prospect'];
    if(styleSel && styleSel.value) picks.push('style-' + bezSlug(styleSel.value));
    if(colorSel && colorSel.value) picks.push('color-' + bezSlug(colorSel.value));
    if(sizeSel && sizeSel.value)   picks.push('size-' + bezSlug(sizeSel.value));
    if(tagsInput) tagsInput.value = picks.join(', ');
    // Name is optional: if left blank, derive a friendly first name from the
    // email so a missing name can never block the reservation.
    if(nameInput && !nameInput.value.trim() && emailInput && emailInput.value){
      var local = emailInput.value.split('@')[0].split(/[._+-]+/)[0];
      nameInput.value = local ? local.charAt(0).toUpperCase() + local.slice(1) : 'Friend';
    }
    // no preventDefault: the native Shopify customer form submits normally.
  });
});

// After a successful reservation, Shopify reloads with the confirmation shown.
// Scroll it into view so it's obvious the reservation went through.
(function(){
  var ok = document.querySelector('.reserve-form .form-success');
  if(ok){ try{ ok.scrollIntoView({behavior:'smooth', block:'center'}); }catch(e){ ok.scrollIntoView(); } }
})();

// "Reserve Yours" buttons on the product cards preselect that style/color and
// jump to the form (the href="#waitlist" handles the scroll).
document.querySelectorAll('[data-reserve]').forEach(function(btn){
  btn.addEventListener('click', function(){
    var form = document.querySelector('.reserve-form');
    if(!form) return;
    var styleSel = form.querySelector('[name="_style"]');
    var colorSel = form.querySelector('[name="_color"]');
    if(btn.dataset.style && styleSel){ styleSel.value = btn.dataset.style; styleSel.dispatchEvent(new Event('change')); }
    var product = btn.closest('.product');
    var color = btn.dataset.color || (product && product.getAttribute('data-color'));
    if(color && colorSel && !colorSel.disabled){ colorSel.value = color.charAt(0).toUpperCase() + color.slice(1); }
  });
});

// After a reservation is submitted, Shopify reloads the page and renders the
// confirmation message. Scroll it into view so the customer clearly sees that
// the reservation worked.
var confirmMsg = document.querySelector('.form-success');
if(confirmMsg){ confirmMsg.scrollIntoView({behavior:'smooth', block:'center'}); }

function joinWaitlist(form){
  var email = form.email.value;
  // No backend yet. Store locally and confirm. Swap for a real email
  // capture endpoint (Mailchimp, Klaviyo, etc.) before launch.
  try{
    var list = JSON.parse(localStorage.getItem('bez-waitlist')||'[]');
    if(list.indexOf(email)===-1){list.push(email);}
    localStorage.setItem('bez-waitlist', JSON.stringify(list));
  }catch(e){}
  form.reset();
  var btn = form.querySelector('button');
  var original = btn.innerHTML;
  btn.innerHTML = "You're on the list ✓";
  btn.disabled = true;
  setTimeout(function(){btn.innerHTML = original; btn.disabled = false;}, 3500);
  return false;
}

// ---- Cart (Buy mode only) ---------------------------------------------------
// Uses Shopify's AJAX Cart API. Only runs when the cart drawer exists, i.e.
// when the theme "Store mode" setting is "Buy".
(function(){
  var drawer = document.getElementById('cart-drawer');
  if(!drawer) return;
  var overlay  = document.getElementById('cart-overlay');
  var itemsEl  = document.getElementById('cart-items');
  var subEl    = document.getElementById('cart-subtotal');
  var toggle   = document.getElementById('cart-toggle');
  var closeBtn = document.getElementById('cart-close');
  var countEls = document.querySelectorAll('.cart-count');

  function money(c){ return '$' + (c/100).toFixed(2); }
  function esc(s){ var d=document.createElement('div'); d.textContent=s==null?'':s; return d.innerHTML; }
  function openDrawer(){ drawer.classList.add('open'); overlay.classList.add('open'); drawer.setAttribute('aria-hidden','false'); document.body.style.overflow='hidden'; }
  function closeDrawer(){ drawer.classList.remove('open'); overlay.classList.remove('open'); drawer.setAttribute('aria-hidden','true'); document.body.style.overflow=''; }

  function render(cart){
    countEls.forEach(function(el){ el.textContent = cart.item_count; el.style.display = cart.item_count>0 ? 'inline-flex' : 'none'; });
    if(!cart.items || cart.item_count===0){
      itemsEl.innerHTML = '<p class="cart-empty">Your cart is empty.</p>';
      subEl.textContent = '';
      return;
    }
    itemsEl.innerHTML = cart.items.map(function(it){
      return '<div class="cart-line" data-key="'+esc(it.key)+'">'
        + (it.image ? '<img class="cart-line-img" src="'+esc(it.image)+'" alt="" width="64" height="80">' : '<div class="cart-line-img"></div>')
        + '<div class="cart-line-info">'
        +   '<div class="cart-line-title">'+esc(it.product_title)+'</div>'
        +   (it.variant_title ? '<div class="cart-line-variant">'+esc(it.variant_title)+'</div>' : '')
        +   '<div class="cart-qty"><button type="button" class="qbtn qminus" data-key="'+esc(it.key)+'" aria-label="Decrease">&minus;</button>'
        +     '<span class="qval">'+it.quantity+'</span>'
        +     '<button type="button" class="qbtn qplus" data-key="'+esc(it.key)+'" aria-label="Increase">+</button>'
        +     '<button type="button" class="qremove" data-key="'+esc(it.key)+'">Remove</button></div>'
        + '</div>'
        + '<div class="cart-line-price">'+money(it.final_line_price)+'</div>'
        + '</div>';
    }).join('');
    subEl.textContent = money(cart.total_price);
  }

  function refresh(open){
    fetch('/cart.js',{headers:{'Accept':'application/json'}})
      .then(function(r){ return r.json(); })
      .then(function(cart){ render(cart); if(open) openDrawer(); })
      .catch(function(){});
  }
  function change(key, qty){
    fetch('/cart/change.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({id:key,quantity:qty})})
      .then(function(r){ return r.json(); }).then(render).catch(function(){});
  }
  function add(id, btn){
    btn && (btn.disabled=true);
    fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({items:[{id:id,quantity:1}]})})
      .then(function(r){ return r.json().then(function(d){ return {ok:r.ok,d:d}; }); })
      .then(function(res){ btn && (btn.disabled=false); if(res.ok){ refresh(true); } else { alert((res.d && res.d.description) || 'Could not add to cart.'); } })
      .catch(function(){ btn && (btn.disabled=false); });
  }

  // Wire each product's Add to Cart: resolve the variant from selected size (+ color).
  document.querySelectorAll('.buy-controls').forEach(function(box){
    var addBtn  = box.querySelector('.buy-add');
    var sizeSel = box.querySelector('.buy-size');
    var msg     = box.querySelector('.buy-msg');
    var product = box.closest('.product');
    var variants = [], optNames = [];
    try{ variants = JSON.parse(box.getAttribute('data-variants')||'[]') || []; }catch(e){}
    try{ optNames = JSON.parse(box.getAttribute('data-options')||'[]') || []; }catch(e){}
    if(!addBtn) return;
    if(!variants.length){ addBtn.textContent = 'Coming soon'; addBtn.disabled = true; addBtn.classList.remove('btn-primary'); addBtn.classList.add('btn-outline'); return; }
    addBtn.addEventListener('click', function(){
      var size = sizeSel ? sizeSel.value : '';
      if(sizeSel && !size){ if(msg) msg.textContent = 'Please choose a size.'; return; }
      var activeSwatch = product && product.querySelector('.swatch.is-active');
      var color = activeSwatch ? activeSwatch.getAttribute('data-name') : null;
      var match = variants.filter(function(v){
        return optNames.every(function(name, i){
          var val = v['option'+(i+1)];
          if(/size/i.test(name)) return val === size;
          if(/colou?r/i.test(name)) return !color || val === color;
          return true;
        });
      })[0];
      if(!match){ if(msg) msg.textContent = 'That size is unavailable.'; return; }
      if(match.available === false){ if(msg) msg.textContent = 'Sold out in that size.'; return; }
      if(msg) msg.textContent = '';
      add(match.id, addBtn);
    });
  });

  if(toggle)   toggle.addEventListener('click', function(){ refresh(true); });
  if(closeBtn) closeBtn.addEventListener('click', closeDrawer);
  if(overlay)  overlay.addEventListener('click', closeDrawer);
  document.addEventListener('keydown', function(e){ if(e.key==='Escape') closeDrawer(); });
  itemsEl.addEventListener('click', function(e){
    var key = e.target.getAttribute('data-key'); if(!key) return;
    var span = itemsEl.querySelector('.cart-line[data-key="'+key+'"] .qval');
    var qty = span ? parseInt(span.textContent,10) : 0;
    if(e.target.classList.contains('qplus'))       change(key, qty+1);
    else if(e.target.classList.contains('qminus')) change(key, Math.max(0, qty-1));
    else if(e.target.classList.contains('qremove'))change(key, 0);
  });

  refresh(false); // initialise the cart count on load
})();
</script>
