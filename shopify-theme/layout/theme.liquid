<style>
/* ---------- Poppins (self hosted) ---------- */
@font-face{font-family:'Poppins';font-style:normal;font-weight:400;font-display:swap;src:url({{ 'poppins-400.woff2' | asset_url }}) format('woff2')}
@font-face{font-family:'Poppins';font-style:normal;font-weight:500;font-display:swap;src:url({{ 'poppins-500.woff2' | asset_url }}) format('woff2')}
@font-face{font-family:'Poppins';font-style:normal;font-weight:600;font-display:swap;src:url({{ 'poppins-600.woff2' | asset_url }}) format('woff2')}
@font-face{font-family:'Poppins';font-style:normal;font-weight:700;font-display:swap;src:url({{ 'poppins-700.woff2' | asset_url }}) format('woff2')}
@font-face{font-family:'Poppins';font-style:normal;font-weight:800;font-display:swap;src:url({{ 'poppins-800.woff2' | asset_url }}) format('woff2')}
@font-face{font-family:'Poppins';font-style:normal;font-weight:900;font-display:swap;src:url({{ 'poppins-900.woff2' | asset_url }}) format('woff2')}
@font-face{font-family:'Great Vibes';font-style:normal;font-weight:400;font-display:swap;src:url({{ 'greatvibes-400.woff2' | asset_url }}) format('woff2')}

:root{
  --purple:#7c3aed;
  --purple-deep:#5b21b6;
  --purple-neon:#a855f7;
  --purple-soft:#f2ecfd;
  --gold:#c9a227;
  --gold-light:#e8c95c;
  --ink:#20182e;
  --ink-soft:#5c5273;
  --cream:#faf8fd;
  --marble:#f1eafb;
  --white:#ffffff;
  --line:rgba(124,58,237,.16);
  --radius:16px;
  --shadow:0 14px 40px rgba(32,24,46,.10);
  --font:'Poppins',system-ui,-apple-system,Segoe UI,Arial,sans-serif;
  --maxw:1240px;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;font-size:17px}
body{font-family:var(--font);color:var(--ink);background:var(--cream);line-height:1.65;font-weight:400;overflow-x:hidden}
img{max-width:100%}
a{color:inherit;text-decoration:none}
h1,h2,h3,h4{line-height:1.12;letter-spacing:-.01em;font-weight:800}
.container{max-width:var(--maxw);margin:0 auto;padding:0 32px}
section{padding:88px 0}
@media(max-width:640px){html{font-size:16px}section{padding:60px 0}.container{padding:0 22px}}

/* ---------- buttons ---------- */
.btn{display:inline-flex;align-items:center;gap:10px;font-family:var(--font);font-weight:700;font-size:.9rem;letter-spacing:.05em;text-transform:uppercase;padding:16px 32px;border-radius:10px;border:2px solid transparent;cursor:pointer;transition:.25s}
.btn-primary{background:linear-gradient(135deg,var(--purple-neon),var(--purple-deep));color:#fff;box-shadow:0 8px 22px rgba(124,58,237,.32)}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 12px 30px rgba(124,58,237,.45)}
.btn-outline{border-color:var(--purple);color:var(--purple);background:transparent}
.btn-outline:hover{background:var(--purple);color:#fff}
.btn-light{border-color:rgba(255,255,255,.55);color:#fff}
.btn-light:hover{background:#fff;color:var(--purple-deep)}

/* ---------- nav ---------- */
header{position:sticky;top:0;z-index:50;background:rgba(250,248,253,.9);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
.nav{display:flex;align-items:center;justify-content:space-between;padding:14px 32px;max-width:1360px;margin:0 auto}
.nav-links{display:flex;gap:34px;font-size:.82rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-soft)}
.nav-links a:hover{color:var(--purple)}
.nav .btn{padding:11px 22px;font-size:.74rem}
.nav-cta{display:flex;align-items:center;gap:22px}
.nav-account{font-size:.82rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-soft);white-space:nowrap}
.nav-account:hover{color:var(--purple)}
.nav-logo{display:block;width:110px;transition:transform .25s}
.nav-logo:hover{transform:scale(1.05)}
.nav-logo img{display:block;width:100%;height:auto;filter:drop-shadow(0 1px 3px rgba(32,24,46,.18))}
@media(max-width:940px){.nav-links{display:none}}
@media(max-width:560px){.nav-account{display:none}}

/* ---------- section headings ---------- */
h2.title{font-size:clamp(2rem,3.8vw,2.9rem);font-weight:700;text-align:center;text-wrap:balance}
h2.title .accent{color:var(--purple)}
.sub{max-width:46rem;margin:20px auto 0;text-align:center;color:var(--ink-soft);font-size:1.05rem}

/* ---------- hero ---------- */
.hero{position:relative;color:var(--ink);overflow:hidden;padding:72px 0;background:
  radial-gradient(1000px 520px at 12% 18%,rgba(168,85,247,.16),transparent 60%),
  linear-gradient(180deg,var(--cream),var(--marble))}
/* neon sign turned off — new transparent hero graphic goes here */
.hero::before,.hero::after{content:none}
.hero .container{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,26rem) min(37vw,500px);column-gap:230px;row-gap:48px;align-items:center;justify-content:center;max-width:1360px}
.hero-inner{max-width:100%}
/* graphic sits in line (side by side) with the hero text; grid gap guarantees spacing, no overlap */
.hero-art{width:auto;max-width:100%;height:auto;max-height:720px;justify-self:center;align-self:center;border-radius:var(--radius)}
.hero-art-m{display:none} /* mobile-only copy of the hero graphic, sits right under the headline */
.hero h1{font-size:clamp(2.6rem,5.4vw,4rem);font-weight:700;letter-spacing:-.02em}
.hero h1 .accent{color:var(--purple)}
.hero p.lead{margin:24px 0 34px;font-size:1.2rem;color:var(--ink-soft);max-width:34rem}
.hero-ctas{display:flex;gap:16px;flex-wrap:wrap}
.hero .btn-outline{border-color:var(--purple);color:var(--purple)}
.hero .btn-outline:hover{background:var(--purple);color:#fff}
.hero-badges{grid-column:1/-1;display:flex;justify-content:center;gap:56px;margin-top:48px;flex-wrap:wrap}
.badge{display:flex;align-items:center;gap:13px;font-size:.95rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--ink);white-space:nowrap}
.badge small{display:block;font-weight:500;font-size:.85rem;color:var(--ink-soft);text-transform:none;letter-spacing:0}
.badge .ico{width:33px;height:33px}
.badge .ico{color:var(--gold);flex-shrink:0}
.photo-frame{border-radius:var(--radius);overflow:hidden;box-shadow:0 22px 50px rgba(32,24,46,.26);border:1px solid var(--line);line-height:0}
.infographic-frame{border:0}
.photo-frame img{width:100%;height:100%;object-fit:cover;display:block}
@media(max-width:1200px){
  .hero{padding:48px 0 56px}
  .hero .container{grid-template-columns:1fr;gap:0}
  .hero-art{display:none}
  .hero-art-m{display:block;width:100%;max-width:390px;height:auto;margin:24px auto 4px;border-radius:var(--radius)}
  .hero-inner{max-width:100%;text-align:center}
  .hero h1{font-size:clamp(2rem,8.4vw,2.9rem)}
  .hero p.lead{font-size:1.06rem;margin-left:auto;margin-right:auto}
  .hero-ctas{justify-content:center}
  .hero-ctas .btn{flex:1 1 auto;justify-content:center;text-align:center}
  .hero-badges{gap:16px 26px;margin-top:34px}
}

/* ---------- inclusivity band ---------- */
.inclusive{background:linear-gradient(135deg,var(--purple-deep),var(--purple));color:#fff;padding:30px 0}
.inclusive .container{display:flex;align-items:center;justify-content:center;gap:22px;text-align:center;flex-wrap:wrap}
.inclusive .pride{width:46px;height:46px;border-radius:50%;flex-shrink:0;background:conic-gradient(#e63946,#f4a261,#e9c46a,#2a9d8f,#457b9d,#7c3aed,#e63946);box-shadow:0 0 0 4px rgba(255,255,255,.18)}
.inclusive p{font-size:1.05rem;font-weight:500;max-width:40rem}
.inclusive strong{font-weight:800}

/* ---------- about ---------- */
.about{position:relative;overflow:hidden;padding-bottom:44px}
.about .emblem-bg{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:min(330px,58vw);height:auto;opacity:.08;pointer-events:none;filter:saturate(1.1)}
@media(max-width:640px){.about .emblem-bg{width:min(190px,52vw);opacity:.06}}
.about .container{position:relative;z-index:1}

/* ---------- feature cards ---------- */
.features{background:var(--white);padding-top:44px}
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;margin-top:0}
.card{background:var(--cream);border:1px solid var(--line);border-radius:var(--radius);padding:44px 32px;text-align:center;box-shadow:var(--shadow);transition:.25s}
.card:hover{transform:translateY(-5px);border-color:var(--purple-neon)}
.card .frame{width:78px;height:78px;margin:0 auto 24px;display:flex;align-items:center;justify-content:center;transform:rotate(45deg);border:2px solid var(--purple);border-radius:12px;background:var(--purple-soft)}
.card .frame svg{transform:rotate(-45deg)}
.card h3{font-size:1rem;font-weight:700;letter-spacing:.01em;margin-bottom:12px}
.card p{font-size:.98rem;color:var(--ink-soft)}
@media(max-width:940px){
  /* Mobile: swipe the feature cards horizontally instead of stacking them */
  .cards{display:flex;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;
    margin:0 -22px;padding:6px 22px 22px;scrollbar-width:none}
  .cards::-webkit-scrollbar{display:none}
  .card{flex:0 0 auto;width:clamp(240px,78vw,320px);scroll-snap-align:center}
}

/* ---------- technology ---------- */
.design{background:
  radial-gradient(1000px 520px at 12% 18%,rgba(168,85,247,.16),transparent 60%),
  linear-gradient(180deg,var(--cream),var(--marble))}
.design-grid{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center;margin-top:14px}
.design h2{text-align:left}
.design p.intro{color:var(--ink-soft);margin:20px 0;font-size:1.08rem}
.design ul{list-style:none;margin-top:10px}
.design li{display:flex;gap:16px;align-items:flex-start;padding:16px 0;border-bottom:1px solid var(--line)}
.design li:last-child{border-bottom:none}
.design li .dot{color:var(--purple-neon);font-weight:900;flex-shrink:0;font-size:1.1rem;line-height:1.3}
.design li strong{display:block;font-size:.9rem;letter-spacing:.06em;text-transform:uppercase;margin-bottom:2px}
.design li span{font-size:.98rem;color:var(--ink-soft)}
@media(max-width:940px){.design-grid{grid-template-columns:1fr;gap:44px}}

/* ---------- anatomy ---------- */
.anatomy{background:var(--white)}
.anatomy-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;margin-top:56px}
.anat{background:var(--cream);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow);transition:.25s}
.anat:hover{transform:translateY(-5px);border-color:var(--purple-neon)}
.anat .diagram{aspect-ratio:4/5;background:
  radial-gradient(440px 320px at 50% 22%,rgba(168,85,247,.28),transparent 65%),
  linear-gradient(165deg,#2a1748 0%,#181026 55%,#241638 100%)}
.anat .diagram svg{width:100%;height:100%;display:block}
.airline{stroke-dasharray:7 9;animation:bezflow 1.5s linear infinite}
.airline.slow{animation-duration:2.2s}
@keyframes bezflow{to{stroke-dashoffset:-64}}
.heatwave{animation:bezrise 2.6s ease-in-out infinite}
.heatwave.d2{animation-delay:.9s}
.heatwave.d3{animation-delay:1.7s}
@keyframes bezrise{0%{opacity:0;transform:translateY(6px)}35%{opacity:.9}100%{opacity:0;transform:translateY(-14px)}}
.pouchglow{animation:bezpulse 3s ease-in-out infinite}
@keyframes bezpulse{0%,100%{opacity:.55}50%{opacity:1}}
@media(prefers-reduced-motion:reduce){.airline,.heatwave,.pouchglow{animation:none}}
.anat .body{padding:26px 28px 32px}
.anat .num{font-size:.72rem;font-weight:800;letter-spacing:.2em;color:var(--purple);text-transform:uppercase}
.anat h3{font-size:1.1rem;font-weight:700;margin:8px 0 10px}
.anat p{font-size:.96rem;color:var(--ink-soft)}
@media(max-width:940px){.anatomy-grid{grid-template-columns:1fr}}

/* ---------- built-for strip ---------- */
.built{background:
  radial-gradient(1000px 520px at 12% 18%,rgba(168,85,247,.16),transparent 60%),
  linear-gradient(180deg,var(--cream),var(--marble));padding:72px 0}
.built-strip{display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:12px 28px;max-width:64rem;margin:44px auto 0}
.built-strip span{display:inline-flex;align-items:center;gap:9px;color:var(--ink);font-size:1.12rem;font-weight:600;letter-spacing:.01em}
.built-strip svg{width:20px;height:20px;color:var(--purple);flex-shrink:0}
@media(max-width:560px){.built-strip span{font-size:1.02rem}}

/* ---------- night banner ---------- */
.night{background:
  radial-gradient(1000px 560px at 82% 18%,rgba(168,85,247,.34),transparent 55%),
  radial-gradient(760px 440px at 8% 92%,rgba(124,58,237,.28),transparent 60%),
  linear-gradient(135deg,#241443 0%,#160f26 55%,#2c1a4d 100%);
  color:#fff}
.night-grid{display:grid;grid-template-columns:0.92fr 1.08fr;gap:52px;align-items:center}
.night h2{font-size:clamp(2.2rem,4.4vw,3.2rem);font-weight:700}
.night h2 .accent{color:var(--purple-neon)}
.night p{color:rgba(255,255,255,.78);margin:22px 0 30px;max-width:30rem;font-size:1.08rem}
.tagline{font-size:1.5rem;font-weight:900;font-style:italic;text-transform:uppercase;color:var(--gold-light);letter-spacing:.02em;margin:6px 0 30px}
.night .tagline{background:linear-gradient(92deg,#f6d987,#e8c95c 35%,#c9a227 70%,#f2d377);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:transparent;filter:drop-shadow(0 0 14px rgba(201,162,39,.35))}
/* ---- real 360 product video ---- */
.rv-wrap{max-width:680px;justify-self:center;position:relative;background:#0d0812;overflow:hidden}
.rv-wrap video{width:100%;display:block}
.rv-stage{position:relative;line-height:0}
.rv-scrim{position:absolute;inset:0 0 auto 0;height:40%;background:linear-gradient(180deg,#0d0812 0%,#0d0812 46%,rgba(13,8,18,.9) 66%,rgba(13,8,18,.58) 82%,rgba(13,8,18,.24) 93%,rgba(13,8,18,0) 100%);pointer-events:none}
.rv-cap{padding:57px 14px 6px;text-align:center;line-height:1.15}
.rv-cap .a{display:block;font-family:'Great Vibes',cursive;font-size:clamp(3.6rem,8.6vw,4.8rem);font-weight:700;text-transform:none;
  line-height:1.28;padding:0 .25em;
  background:linear-gradient(94deg,#f6d987 5%,#e8c95c 38%,#c9a227 68%,#f2d377 95%);
  -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:transparent;
  filter:drop-shadow(0 0 12px rgba(201,162,39,.35))}
.rv-cap .b{display:block;font-size:.78rem;font-weight:600;letter-spacing:.38em;color:rgba(255,255,255,.68);text-transform:uppercase;margin-top:6px}
.rv-wrap .rv-logo{position:absolute;right:12px;bottom:10px;width:72px;height:auto;object-fit:contain;opacity:.72;filter:drop-shadow(0 1px 4px rgba(0,0,0,.6));pointer-events:none}
@media(max-width:940px){.night-grid{grid-template-columns:1fr;gap:44px}}

/* ---------- collection ---------- */
.collection{background:var(--white)}
.products{display:grid;grid-template-columns:repeat(2,minmax(0,400px));gap:34px;margin-top:56px;justify-content:center;align-items:stretch}
.product{border-radius:var(--radius);overflow:hidden;border:1px solid var(--line);box-shadow:var(--shadow);background:var(--cream);display:flex;flex-direction:column;transition:.25s}
.product:hover{transform:translateY(-5px);border-color:var(--purple-neon)}
.product .visual{aspect-ratio:4/5;overflow:hidden;position:relative;display:flex;align-items:center;justify-content:center}
.product .visual img{width:100%;height:100%;object-fit:cover;display:block}
.product .visual.flip{background:#fff}
.product .visual.flip .face{position:absolute;inset:0;transition:opacity .5s ease}
.product .visual.flip .face.back{opacity:0}
@media(hover:hover){
  .product .visual.flip:hover .face.front{opacity:0}
  .product .visual.flip:hover .face.back{opacity:1}
}
.product.flipped .visual.flip .face.front{opacity:0}
.product.flipped .visual.flip .face.back{opacity:1}
.product .visual.flip{cursor:pointer}
.product .visual.flip .flip-cue{position:absolute;right:12px;bottom:12px;z-index:3;width:36px;height:36px;border-radius:50%;background:rgba(124,58,237,.92);color:#fff;display:flex;align-items:center;justify-content:center;font-size:1.15rem;line-height:1;box-shadow:0 4px 14px rgba(0,0,0,.28);pointer-events:none}
@media(hover:hover){.product .visual.flip .flip-cue{display:none}}
.product .visual.special{background:
  radial-gradient(420px 340px at 50% 40%,rgba(168,85,247,.4),transparent 62%),
  linear-gradient(160deg,#2a1748,#140d1f)}
.product .visual.special img{width:70%;height:auto;filter:drop-shadow(0 10px 30px rgba(168,85,247,.5))}
.product .tag{position:absolute;top:14px;left:14px;z-index:2;font-size:.64rem;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:#fff;background:linear-gradient(135deg,var(--purple-neon),var(--purple-deep));border-radius:99px;padding:6px 14px}
.product .tag.soft{background:var(--white);color:var(--purple);border:1px solid var(--purple)}
.product .info{padding:26px 28px 32px;text-align:center;flex:1;display:flex;flex-direction:column}
.product .info>.buy-controls,.product .info>.btn{margin-top:auto}
.product h3{font-size:1.3rem;font-weight:700}
.product .price{font-size:1.3rem;font-weight:700;color:var(--purple);margin-top:4px}
.product .price-unit{font-size:.82rem;font-weight:600;color:var(--ink-soft);letter-spacing:.02em}
.product p{font-size:.96rem;color:var(--ink-soft);margin:10px 0 14px;min-height:3em}
.product .includes{font-size:.82rem;line-height:1.5;color:var(--ink-soft);padding:11px 14px;margin-bottom:20px;background:var(--marble);border:1px solid var(--line);border-radius:10px}
.collection .shop-all{text-align:center;margin-top:56px}
.color-pick{margin:6px 0 22px}
.color-avail{font-size:.9rem;color:var(--ink-soft);margin-bottom:12px}
.color-avail .color-name{color:var(--purple);font-weight:700}
.swatches,.swatches-lock{display:flex;gap:12px;justify-content:center}
.swatches-lock .swatch{cursor:default}
.swatches-lock .swatch:hover{transform:none}
.swatch{width:30px;height:30px;border-radius:50%;border:2px solid var(--line);cursor:pointer;padding:0;transition:transform .18s,box-shadow .18s,border-color .18s}
.swatch-white{background:#fff;border-color:#cdc2ec}
.swatch-black{background:#1b1b1f}
.swatch:hover{transform:scale(1.1)}
.swatch.is-active{border-color:var(--purple);box-shadow:0 0 0 3px rgba(124,58,237,.22)}

/* ---------- size guide ---------- */
.sizing{background:var(--marble)}
.size-wrap{max-width:760px;margin:56px auto 0;background:var(--white);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);overflow:hidden}
.size-table{width:100%;border-collapse:collapse;font-size:1rem}
.size-table th,.size-table td{padding:16px 22px;text-align:left}
.size-table thead th{background:linear-gradient(135deg,var(--purple),var(--purple-deep));color:#fff;font-size:.72rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase}
.size-table tbody tr{border-top:1px solid var(--line)}
.size-table tbody tr:nth-child(odd){background:var(--cream)}
.size-table td:first-child{font-weight:800;color:var(--purple);text-transform:uppercase}
.size-table td{color:var(--ink-soft)}
.size-note{text-align:center;color:var(--ink-soft);font-size:.9rem;margin-top:20px}
@media(max-width:560px){.size-table th,.size-table td{padding:13px 14px;font-size:.92rem}}
@media(max-width:940px){.products{grid-template-columns:1fr;max-width:440px;margin-left:auto;margin-right:auto}}

/* ---------- testimonials ---------- */
.field{background:
  radial-gradient(860px 500px at 14% 8%,rgba(168,85,247,.3),transparent 55%),
  linear-gradient(150deg,#241443 0%,#181026 60%,#2c1a4d 100%);color:#fff}
.field .title{color:#fff}
.field .title .accent{color:var(--purple-neon)}
.quotes{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;margin-top:56px}
.quote{background:rgba(255,255,255,.055);border:1px solid rgba(168,85,247,.3);border-radius:var(--radius);padding:38px 32px;position:relative}
.quote .mark{font-size:3.6rem;line-height:1;color:var(--purple-neon);font-family:Georgia,serif;position:absolute;top:16px;left:24px;opacity:.85}
.quote p{margin-top:36px;font-size:1rem;color:rgba(255,255,255,.9);font-style:italic}
.quote footer{margin-top:20px;font-size:.74rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--purple-neon)}
.quote.quote-invite{background:linear-gradient(135deg,rgba(201,162,39,.14),rgba(168,85,247,.05));border-color:var(--gold);border-style:dashed}
.quote.quote-invite .mark{color:var(--gold-light);font-family:var(--font);font-style:normal;font-weight:900}
.quote.quote-invite footer a{color:var(--gold-light)}
@media(max-width:940px){.quotes{grid-template-columns:1fr}}

/* ---------- waitlist ---------- */
.waitlist{background:
  radial-gradient(860px 440px at 84% 26%,rgba(168,85,247,.24),transparent 60%),
  linear-gradient(180deg,var(--marble),var(--cream))}
.wait-grid{display:grid;grid-template-columns:1.06fr .94fr;gap:64px;align-items:center}
.waitlist h2{font-size:clamp(2.2rem,4.2vw,3rem);font-weight:700;font-style:italic}
.waitlist h2 .accent{color:var(--purple)}
.waitlist p{color:var(--ink-soft);margin:20px 0 30px;max-width:30rem;font-size:1.08rem}
.wait-form{display:flex;gap:12px;flex-wrap:wrap}
.wait-form input{flex:1;min-width:250px;padding:16px 20px;border:1.5px solid var(--line);border-radius:10px;font-size:1rem;font-family:var(--font);background:#fff;color:var(--ink)}
.wait-form input:focus{outline:2px solid var(--purple);border-color:transparent}
.form-note{font-size:.85rem;color:var(--ink-soft);margin-top:14px}
.form-success{flex:0 0 100%;width:100%;order:9;margin-top:16px;padding:13px 18px;border-radius:12px;background:var(--purple);color:#fff!important;font-weight:600;font-size:.96rem;line-height:1.5;box-shadow:0 10px 28px rgba(124,58,237,.28)}
.wait-form .errors,.foot-form .errors,.reserve-form .errors{flex:0 0 100%;width:100%;order:9;list-style:none;margin:12px 0 0;padding:0;color:#dc2626;font-size:.9rem;font-weight:600}
.foot-form .form-success{font-size:.9rem;padding:11px 14px;margin-top:12px}
.wait-emblem{display:flex;justify-content:center}
@media(max-width:940px){.wait-grid{grid-template-columns:1fr}.wait-emblem{display:none}}
/* ---- reservation picker ---- */
.reserve-form{display:block}
.reserve-fields{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:12px}
.rf{display:block;text-align:left}
.rf>span{display:block;font-size:.72rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:6px}
.rf select{width:100%;padding:14px 14px;border:1.5px solid var(--line);border-radius:10px;font-size:1rem;font-family:var(--font);background:#fff;color:var(--ink);cursor:pointer}
.rf select:focus{outline:2px solid var(--purple);border-color:transparent}
.rf select:disabled{opacity:.5;cursor:not-allowed;background:var(--marble)}
.reserve-contact{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:14px}
.reserve-contact input{flex:1;min-width:200px;padding:15px 18px;border:1.5px solid var(--line);border-radius:10px;font-size:1rem;font-family:var(--font);background:#fff;color:var(--ink)}
.reserve-contact input:focus{outline:2px solid var(--purple);border-color:transparent}
.reserve-form>.btn-primary{width:100%;justify-content:center}
@media(max-width:560px){.reserve-fields{grid-template-columns:1fr}}

/* ---------- FAQ ---------- */
.faq{background:var(--white)}
.privacy{background:var(--cream)}
.privacy .legal{max-width:56rem;margin:30px auto 0;color:var(--ink-soft);font-size:1rem;line-height:1.7}
.privacy .legal .updated{font-size:.9rem;margin-bottom:22px}
.privacy .legal h3{color:var(--ink);font-size:1rem;font-weight:700;letter-spacing:.01em;margin:26px 0 8px}
.privacy .legal p{margin:0 0 12px}
.privacy .legal a{color:var(--purple);text-decoration:underline}
.faq-list{max-width:880px;margin:56px auto 0;display:grid;gap:14px}
.faq-item{border:1px solid var(--line);border-radius:12px;background:var(--cream);overflow:hidden}
.faq-item summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:16px;padding:20px 24px;font-size:.9rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase}
.faq-item summary::-webkit-details-marker{display:none}
.faq-item summary .plus{color:var(--purple);font-size:1.3rem;font-weight:400;transition:.2s;line-height:1}
.faq-item[open] summary .plus{transform:rotate(45deg)}
.faq-item .answer{padding:0 24px 22px;color:var(--ink-soft);font-size:1rem}

/* ---------- footer ---------- */
footer#contact{background:linear-gradient(180deg,#20182e,#140d1f);color:rgba(255,255,255,.72);padding:72px 0 32px}
.foot-grid{display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr;gap:44px}
.foot-grid h4{font-size:.82rem;font-weight:700;letter-spacing:.01em;color:#fff;margin-bottom:18px}
.foot-grid ul{list-style:none;display:grid;gap:11px;font-size:.94rem}
.foot-grid a:hover{color:var(--purple-neon)}
.foot-brand .nav-logo{width:158px}
.foot-brand p{font-size:.8rem;letter-spacing:.05em;text-transform:uppercase;margin-top:16px;color:rgba(255,255,255,.6)}
.foot-brand .foot-contact{text-transform:none;letter-spacing:0;font-size:.9rem;margin-top:14px}
.foot-brand .foot-contact a{color:var(--purple-neon)}
.foot-brand .foot-contact a:hover{color:#fff}
.foot-social{display:flex;gap:12px;margin-top:20px}
.foot-social a{width:40px;height:40px;border:1px solid rgba(255,255,255,.22);border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;transition:.2s}
.foot-social a:hover{background:var(--purple);border-color:transparent;transform:translateY(-2px)}
.foot-social svg{width:19px;height:19px}
.faq-item .answer a{color:var(--purple);text-decoration:underline}
.foot-form{display:flex;flex-wrap:wrap;gap:0;margin-top:8px}
.foot-form input{flex:1;min-width:0;padding:13px 15px;border:1px solid rgba(255,255,255,.22);border-right:none;border-radius:10px 0 0 10px;background:rgba(255,255,255,.06);color:#fff;font-size:.92rem;font-family:var(--font)}
.foot-form input::placeholder{color:rgba(255,255,255,.42)}
.foot-form button{padding:13px 19px;border:none;border-radius:0 10px 10px 0;background:var(--purple);color:#fff;font-size:1.1rem;cursor:pointer}
.foot-form button:hover{background:var(--purple-neon)}
.foot-bottom{border-top:1px solid rgba(255,255,255,.12);margin-top:52px;padding-top:26px;text-align:center;font-size:.82rem;color:rgba(255,255,255,.45)}
@media(max-width:940px){.foot-grid{grid-template-columns:1fr 1fr}}
@media(max-width:560px){.foot-grid{grid-template-columns:1fr}}

/* ---------- customer account / auth pages ---------- */
.auth{min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:48px 22px;
  background:radial-gradient(120% 90% at 50% -10%,rgba(124,58,237,.10),transparent 60%),linear-gradient(180deg,var(--cream),var(--marble))}
.auth-logo{display:block;width:150px;margin:0 auto 30px}
.auth-logo img{width:100%;height:auto;filter:drop-shadow(0 1px 3px rgba(32,24,46,.18))}
.auth-card{width:100%;max-width:440px;background:#fff;border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);padding:38px 34px;text-align:center}
.auth-card h1{font-size:1.55rem;font-weight:700;margin-bottom:6px}
.auth-sub{color:var(--ink-soft);margin-bottom:24px;font-size:.95rem}
.auth-field{margin-bottom:16px;text-align:left}
.auth-field label{display:block;font-size:.72rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:6px}
.auth-field input{width:100%;padding:14px 16px;border:1.5px solid var(--line);border-radius:10px;font-size:1rem;font-family:var(--font);background:#fff;color:var(--ink)}
.auth-field input:focus{outline:2px solid var(--purple);border-color:transparent}
.auth .btn{width:100%;justify-content:center;margin-top:6px}
.auth-alt{margin-top:18px;font-size:.9rem;color:var(--ink-soft)}
.auth-alt a{color:var(--purple);font-weight:600}
.auth-back{margin-top:24px;font-size:.85rem}
.auth-back a{color:var(--ink-soft)}
.auth-back a:hover{color:var(--purple)}
.auth-errors{background:rgba(200,40,40,.07);border:1.5px solid rgba(200,40,40,.45);color:#b3261e;border-radius:10px;padding:12px 14px;margin-bottom:18px;font-size:.9rem;text-align:left}
.auth-errors ul{margin:0;padding-left:18px}
.auth-note{background:rgba(124,58,237,.09);border:1.5px solid var(--purple);color:var(--ink);border-radius:10px;padding:12px 14px;margin-bottom:18px;font-size:.92rem;text-align:left}
/* account dashboard */
.account{max-width:920px;margin:0 auto;width:100%}
.account-head{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:8px}
.account-head h1{font-size:1.7rem;font-weight:700}
.account-links{display:flex;gap:18px;flex-wrap:wrap;font-size:.85rem;font-weight:600}
.account-links a{color:var(--purple)}
.account-panel{background:#fff;border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);padding:26px 28px;margin-top:22px;text-align:left}
.account-panel h2{font-size:1.05rem;font-weight:700;margin-bottom:14px}
.order-table{width:100%;border-collapse:collapse;font-size:.92rem}
.order-table th,.order-table td{padding:11px 10px;border-bottom:1px solid var(--line);text-align:left}
.order-table th{font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-soft)}
.account-empty{color:var(--ink-soft);font-size:.95rem}

/* ---------- buy mode: cart + add-to-cart ---------- */
.nav-cart{position:relative}
.cart-count{display:none;align-items:center;justify-content:center;min-width:20px;height:20px;padding:0 6px;margin-left:2px;border-radius:99px;background:#fff;color:var(--purple-deep);font-size:.72rem;font-weight:800;line-height:1}
.buy-controls{display:flex;flex-direction:column;gap:12px}
.buy-size{width:100%;padding:14px;border:1.5px solid var(--line);border-radius:10px;font-size:1rem;font-family:var(--font);background:#fff;color:var(--ink);cursor:pointer}
.buy-size:focus{outline:2px solid var(--purple);border-color:transparent}
.buy-add{width:100%;justify-content:center}
.buy-msg{font-size:.82rem;color:#b3261e;min-height:1em;margin:0}
.cart-overlay{position:fixed;inset:0;background:rgba(20,14,30,.5);opacity:0;visibility:hidden;transition:.25s;z-index:60}
.cart-overlay.open{opacity:1;visibility:visible}
.cart-drawer{position:fixed;top:0;right:0;height:100%;width:min(420px,92vw);background:var(--cream);box-shadow:-16px 0 44px rgba(32,24,46,.22);transform:translateX(100%);transition:transform .28s ease;z-index:61;display:flex;flex-direction:column}
.cart-drawer.open{transform:translateX(0)}
.cart-head{display:flex;align-items:center;justify-content:space-between;padding:22px 24px;border-bottom:1px solid var(--line)}
.cart-head h2{font-size:1.15rem;font-weight:700}
.cart-close{background:none;border:none;font-size:1.9rem;line-height:1;color:var(--ink-soft);cursor:pointer;padding:0 4px}
.cart-close:hover{color:var(--purple)}
.cart-items{flex:1;overflow-y:auto;padding:8px 24px}
.cart-empty{color:var(--ink-soft);text-align:center;padding:48px 0}
.cart-line{display:grid;grid-template-columns:64px 1fr auto;gap:14px;align-items:start;padding:18px 0;border-bottom:1px solid var(--line)}
.cart-line-img{width:64px;height:80px;object-fit:cover;border-radius:8px;background:var(--marble)}
.cart-line-title{font-weight:700;font-size:.95rem}
.cart-line-variant{font-size:.82rem;color:var(--ink-soft);margin-top:2px}
.cart-line-price{font-weight:700;font-size:.95rem;white-space:nowrap}
.cart-qty{display:flex;align-items:center;gap:8px;margin-top:10px}
.qbtn{width:26px;height:26px;border:1.5px solid var(--line);background:#fff;border-radius:7px;font-size:1rem;line-height:1;cursor:pointer;color:var(--ink)}
.qbtn:hover{border-color:var(--purple);color:var(--purple)}
.qval{min-width:18px;text-align:center;font-weight:600;font-size:.9rem}
.qremove{margin-left:8px;background:none;border:none;color:var(--ink-soft);font-size:.78rem;text-decoration:underline;cursor:pointer}
.qremove:hover{color:#b3261e}
.cart-foot{border-top:1px solid var(--line);padding:20px 24px 24px}
.cart-subtotal-row{display:flex;justify-content:space-between;font-weight:700;font-size:1.05rem;margin-bottom:16px}
.cart-checkout{width:100%;justify-content:center}
.cart-note{text-align:center;font-size:.78rem;color:var(--ink-soft);margin-top:12px}

/* ---------- product detail + cart pages ---------- */
.pdp{padding:48px 0 72px}
.pdp-grid{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:start}
.pdp-main{width:100%;border-radius:var(--radius);border:1px solid var(--line);background:#fff}
.pdp-thumbs{display:flex;gap:10px;margin-top:12px;flex-wrap:wrap}
.pdp-thumb{width:72px;height:90px;padding:0;border:1.5px solid var(--line);border-radius:8px;overflow:hidden;background:#fff;cursor:pointer}
.pdp-thumb img{width:100%;height:100%;object-fit:cover}
.pdp-thumb:hover{border-color:var(--purple)}
.pdp-info h1{font-size:2rem;font-weight:700;margin-bottom:8px}
.pdp-price{font-size:1.5rem;font-weight:700;color:var(--purple);margin-bottom:24px}
.pdp-form{display:flex;flex-direction:column;gap:16px;max-width:340px}
.pdp-field span{display:block;font-size:.72rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:6px}
.pdp-field select{width:100%;padding:14px;border:1.5px solid var(--line);border-radius:10px;font-size:1rem;font-family:var(--font);background:#fff;color:var(--ink);cursor:pointer}
.pdp-field select:focus{outline:2px solid var(--purple);border-color:transparent}
.pdp-add{justify-content:center}
.pdp-desc{margin-top:28px;color:var(--ink-soft);line-height:1.7;max-width:46ch}
.pdp-desc ul{margin:12px 0;padding-left:20px}
@media(max-width:760px){.pdp-grid{grid-template-columns:1fr;gap:28px}}

.cartpage{padding:48px 0 80px;min-height:60vh}
.cartpage-title{font-size:2rem;font-weight:700;margin-bottom:28px}
.cartpage-line{display:grid;grid-template-columns:88px 1fr auto auto;gap:20px;align-items:center;padding:20px 0;border-bottom:1px solid var(--line)}
.cartpage-img img{width:88px;height:110px;object-fit:cover;border-radius:10px;border:1px solid var(--line);background:#fff}
.cartpage-line-title{font-weight:700;font-size:1.02rem}
.cartpage-line-variant{font-size:.86rem;color:var(--ink-soft);margin-top:2px}
.cartpage-line-price{font-size:.82rem;color:var(--ink-soft);margin-top:4px}
.cartpage-remove{display:inline-block;margin-top:8px;font-size:.8rem;color:var(--ink-soft);text-decoration:underline}
.cartpage-remove:hover{color:#b3261e}
.cartpage-qty{width:66px;padding:10px;border:1.5px solid var(--line);border-radius:8px;font-size:1rem;font-family:var(--font);text-align:center}
.cartpage-line-total{font-weight:700;white-space:nowrap}
.cartpage-foot{display:flex;justify-content:space-between;align-items:flex-start;gap:24px;margin-top:28px;flex-wrap:wrap}
.cartpage-summary{margin-left:auto;min-width:280px;text-align:right}
.cartpage-subtotal{display:flex;justify-content:space-between;font-size:1.15rem;font-weight:700;margin-bottom:6px}
.cartpage-note{font-size:.8rem;color:var(--ink-soft);margin-bottom:14px}
.cartpage-checkout{width:100%;justify-content:center}
.cartpage-empty{color:var(--ink-soft);font-size:1.05rem;margin-bottom:22px}
@media(max-width:560px){.cartpage-line{grid-template-columns:70px 1fr auto;gap:14px}.cartpage-line-total{grid-column:2/4;text-align:right}}
</style>
{{ content_for_header }}
</head>
<body>
{{ content_for_layout }}
