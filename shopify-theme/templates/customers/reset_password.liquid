<div class="auth">
  <a href="/" class="auth-logo" aria-label="BreathEZs home">
    <img src="{{ 'logo.png' | asset_url }}" alt="BEZ BreathEZs">
  </a>

  <div class="auth-card">
    <h1>Set a new password</h1>
    <p class="auth-sub">Choose a new password for your account.</p>
    {% form 'reset_customer_password' %}
      {% if form.errors %}
        <div class="auth-errors">{{ form.errors | default_errors }}</div>
      {% endif %}
      <div class="auth-field">
        <label for="rp-pass">New password</label>
        <input type="password" name="customer[password]" id="rp-pass" autocomplete="new-password" required>
      </div>
      <div class="auth-field">
        <label for="rp-confirm">Confirm password</label>
        <input type="password" name="customer[password_confirmation]" id="rp-confirm" autocomplete="new-password" required>
      </div>
      <button type="submit" class="btn btn-primary">Reset password</button>
    {% endform %}
    <p class="auth-back"><a href="/">&larr; Back to store</a></p>
  </div>
</div>
