<div class="auth">
  <a href="/" class="auth-logo" aria-label="BreathEZs home">
    <img src="{{ 'logo.png' | asset_url }}" alt="BEZ BreathEZs">
  </a>

  <div class="auth-card">
    <h1>Activate your account</h1>
    <p class="auth-sub">Set a password to finish setting up your BreathEZs account.</p>
    {% form 'activate_customer_password' %}
      {% if form.errors %}
        <div class="auth-errors">{{ form.errors | default_errors }}</div>
      {% endif %}
      <div class="auth-field">
        <label for="ac-pass">Password</label>
        <input type="password" name="customer[password]" id="ac-pass" autocomplete="new-password" required>
      </div>
      <div class="auth-field">
        <label for="ac-confirm">Confirm password</label>
        <input type="password" name="customer[password_confirmation]" id="ac-confirm" autocomplete="new-password" required>
      </div>
      <button type="submit" class="btn btn-primary">Activate account</button>
    {% endform %}
    <p class="auth-back"><a href="/">&larr; Back to store</a></p>
  </div>
</div>
