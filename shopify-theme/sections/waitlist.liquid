<section class="waitlist" id="waitlist">
  <div class="container wait-grid">
    <div>
      <h2>{{ section.settings.heading | default: "Get In Before They're" }} <span class="accent">{{ section.settings.heading_accent | default: 'Gone.' }}</span></h2>
      <p>{{ section.settings.intro | default: 'Only a limited few will be made. Reserve yours now for first access to the first release.' }}</p>
      {% form 'customer', class: 'reserve-form' %}<input type="hidden" name="contact[tags]" value="reserve, newsletter, prospect">
        <div class="reserve-fields">
          <label class="rf">
            <span>Style</span>
            <select name="_style" required aria-label="Style">
              <option value="Classic">Classic</option>
              <option value="Special Edition Black">Special Edition Black</option>
            </select>
          </label>
          <label class="rf">
            <span>Color</span>
            <select name="_color" aria-label="Color">
              <option value="White">White</option>
              <option value="Black">Black</option>
            </select>
          </label>
          <label class="rf">
            <span>Size</span>
            <select name="_size" required aria-label="Size">
              <option value="" disabled selected>Select</option>
              <option value="S">S</option>
              <option value="M">M</option>
              <option value="L">L</option>
              <option value="XL">XL</option>
              <option value="2XL">2XL</option>
              <option value="3XL">3XL</option>
            </select>
          </label>
        </div>
        <div class="reserve-contact">
          <input type="text" name="contact[first_name]" placeholder="Your name (optional)" aria-label="Your name">
          <input type="email" name="contact[email]" placeholder="Enter your email" required aria-label="Email address">
        </div>
        <button type="submit" class="btn btn-primary">Reserve Yours</button>
      {% if form.posted_successfully? %}<p class="form-success" role="status">Reserved! Your pick is noted and you're on the list for first access at the August 2026 launch. We'll email you to confirm.</p>{% endif %}{{ form.errors | default_errors }}{% endform %}
      <p class="form-note" id="waitlist-note">{{ section.settings.note | default: 'No charge and no spam &mdash; this reserves your size and style and gets you launch updates.' }}</p>
    </div>
    <div class="wait-emblem">
      <div class="photo-frame" style="max-width:360px">
        <img src="{% if section.settings.image %}{{ section.settings.image | image_url: width: 720 }}{% else %}{{ 'comingsoon.webp' | asset_url }}{% endif %}" loading="lazy" decoding="async" alt="BEZ BreathEZs, the new standard of comfort, coming soon">
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Waitlist / Reserve",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get In Before They're" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (purple)", "default": "Gone." },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Only a limited few will be made. Reserve yours now for first access to the first release." },
    { "type": "text", "id": "note", "label": "Note under form", "default": "No charge and no spam — this reserves your size and style and gets you launch updates." },
    { "type": "image_picker", "id": "image", "label": "Side image", "info": "Leave empty to use the built-in coming-soon graphic." }
  ]
}
{% endschema %}
