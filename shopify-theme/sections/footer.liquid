<footer id="contact">
  <div class="container foot-grid">
    <div class="foot-brand">
      <span class="nav-logo">
        <img src="{{ 'logo.png' | asset_url }}" loading="lazy" decoding="async" alt="BEZ BreathEZs logo">
      </span>
      <p>{{ section.settings.tagline_l1 | default: 'Luxury Underwear.' }}<br>{{ section.settings.tagline_l2 | default: 'Designed to Breathe.' }}</p>
      <p class="foot-contact">Questions? <a href="mailto:{{ section.settings.email | default: 'customerservice@breathezs.com' }}">{{ section.settings.email | default: 'customerservice@breathezs.com' }}</a></p>
      <div class="foot-social">
        <a href="{{ section.settings.instagram | default: 'https://www.instagram.com/breathezs_official/' }}" target="_blank" rel="noopener" aria-label="BreathEZs on Instagram">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5.5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.6" cy="6.4" r="1.3" fill="currentColor" stroke="none"/></svg>
        </a>
        <a href="{{ section.settings.facebook | default: 'https://www.facebook.com/BreathEZs' }}" target="_blank" rel="noopener" aria-label="BreathEZs on Facebook">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M15.6 8.4H14c-.6 0-1 .4-1 1v1.6h2.6l-.4 2.6H13V21h-2.7v-6.8H8.4v-2.6h1.9V9.1c0-1.9 1.2-3.1 3-3.1h2.3v2.4z"/></svg>
        </a>
        <a href="{{ section.settings.tiktok | default: 'https://www.tiktok.com/@breathezs' }}" target="_blank" rel="noopener" aria-label="BreathEZs on TikTok">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.6 5.82a4.28 4.28 0 0 1-1.06-2.82h-3.03v12.16a2.44 2.44 0 1 1-2.44-2.44c.25 0 .5.04.72.11V9.7a5.49 5.49 0 0 0-.72-.05A5.49 5.49 0 1 0 15.55 15V8.9a7.29 7.29 0 0 0 4.25 1.36V7.23a4.28 4.28 0 0 1-3.2-1.41z"/></svg>
        </a>
        <a href="{{ section.settings.youtube | default: 'https://www.youtube.com/@breathezs' }}" target="_blank" rel="noopener" aria-label="BreathEZs on YouTube">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12s0-2.9-.37-4.3a2.28 2.28 0 0 0-1.6-1.6C18.63 5.7 12 5.7 12 5.7s-6.63 0-8.03.4A2.28 2.28 0 0 0 2.37 7.7 24 24 0 0 0 2 12a24 24 0 0 0 .37 4.3 2.28 2.28 0 0 0 1.6 1.6c1.4.4 8.03.4 8.03.4s6.63 0 8.03-.4a2.28 2.28 0 0 0 1.6-1.6C22 14.9 22 12 22 12zM10 15.2V8.8l5.2 3.2z"/></svg>
        </a>
      </div>
    </div>
    <div>
      <h4>Explore</h4>
      <ul>
        <li><a href="{% if settings.store_mode == 'buy' %}#collection{% else %}#waitlist{% endif %}">{% if settings.store_mode == 'buy' %}Shop{% else %}Reserve Yours{% endif %}</a></li>
        <li><a href="#collection">The Collection</a></li>
        <li><a href="#sizing">Sizing</a></li>
      </ul>
    </div>
    <div>
      <h4>Company</h4>
      <ul>
        <li><a href="#about">About</a></li>
        <li><a href="#faq">FAQ</a></li>
        <li><a href="{{ routes.account_url }}">Account</a></li>
        <li><a href="mailto:{{ section.settings.email | default: 'customerservice@breathezs.com' }}">Contact</a></li>
      </ul>
    </div>
    <div>
      <h4>Policies</h4>
      <ul>
        <li><a href="/pages/preorder-policy">Preorder Policy</a></li>
        <li><a href="/pages/shipping-policy">Shipping Policy</a></li>
        <li><a href="/pages/refund-policy">Returns &amp; Refunds</a></li>
        <li><a href="/pages/terms-conditions">Terms &amp; Conditions</a></li>
        <li><a href="/pages/privacy-policy">Privacy Policy</a></li>
      </ul>
    </div>
  </div>
  <div class="container foot-bottom">© 2026 BreathEZs®. All Rights Reserved. &middot; <a href="/pages/terms-conditions" style="color:inherit;text-decoration:underline">Terms</a> &middot; <a href="/pages/privacy-policy" style="color:inherit;text-decoration:underline">Privacy</a> &middot; <a href="/pages/refund-policy" style="color:inherit;text-decoration:underline">Returns</a></div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "tagline_l1", "label": "Tagline line 1", "default": "Luxury Underwear." },
    { "type": "text", "id": "tagline_l2", "label": "Tagline line 2", "default": "Designed to Breathe." },
    { "type": "text", "id": "email", "label": "Contact email", "default": "customerservice@breathezs.com" },
    { "type": "header", "content": "Social links" },
    { "type": "url", "id": "instagram", "label": "Instagram" },
    { "type": "url", "id": "facebook", "label": "Facebook" },
    { "type": "url", "id": "tiktok", "label": "TikTok" },
    { "type": "url", "id": "youtube", "label": "YouTube" }
  ]
}
{% endschema %}
