<section class="features">
  <div class="container">
    <div class="cards">
      <div class="card">
        <div class="frame">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#7c3aed" stroke-width="1.8" aria-hidden="true"><path d="M5 9l3-5h8l3 5-7 11z M5 9h14 M9 4l3 5 3-5 M12 9v11"/></svg>
        </div>
        <h3>{{ section.settings.card1_title | default: 'Elevated Comfort' }}</h3>
        <p>{{ section.settings.card1_body | default: 'Soft, breathable 100% cotton made for all day wear. Under jeans, work gear, or nothing at all.' }}</p>
      </div>
      <div class="card">
        <div class="frame">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#7c3aed" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 8h10a2.5 2.5 0 100-5M4 12h14a2.5 2.5 0 110 5M4 16h7a2.5 2.5 0 11-2.5 4"/></svg>
        </div>
        <h3>{{ section.settings.card2_title | default: 'Breathable Confidence' }}</h3>
        <p>{{ section.settings.card2_body | default: 'Engineered for airflow, cooling, and movement. Every step creates natural ventilation.' }}</p>
      </div>
      <div class="card">
        <div class="frame">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#7c3aed" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21c-4.2-1-6.7-4.8-6.2-9.3.2-2.3 1-4.1 2.2-5.7"/><path d="M12 21c4.2-1 6.7-4.8 6.2-9.3-.2-2.3-1-4.1-2.2-5.7"/><path d="M8.2 8.6C6.8 8.5 5.9 7.8 5.5 6.4"/><path d="M6.7 12C5.3 12.1 4.3 11.5 3.7 10.2"/><path d="M6.9 15.4C5.6 15.9 4.4 15.6 3.5 14.5"/><path d="M15.8 8.6C17.2 8.5 18.1 7.8 18.5 6.4"/><path d="M17.3 12C18.7 12.1 19.7 11.5 20.3 10.2"/><path d="M17.1 15.4C18.4 15.9 19.6 15.6 20.5 14.5"/><circle cx="12" cy="5.4" r=".9"/></svg>
        </div>
        <h3>{{ section.settings.card3_title | default: 'Italian-Inspired Luxury' }}</h3>
        <p>{{ section.settings.card3_body | default: 'Refined styling and premium materials, built for everyday confidence and modern performance.' }}</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Feature cards",
  "settings": [
    { "type": "header", "content": "Card 1" },
    { "type": "text", "id": "card1_title", "label": "Title", "default": "Elevated Comfort" },
    { "type": "textarea", "id": "card1_body", "label": "Body", "default": "Soft, breathable 100% cotton made for all day wear. Under jeans, work gear, or nothing at all." },
    { "type": "header", "content": "Card 2" },
    { "type": "text", "id": "card2_title", "label": "Title", "default": "Breathable Confidence" },
    { "type": "textarea", "id": "card2_body", "label": "Body", "default": "Engineered for airflow, cooling, and movement. Every step creates natural ventilation." },
    { "type": "header", "content": "Card 3" },
    { "type": "text", "id": "card3_title", "label": "Title", "default": "Italian-Inspired Luxury" },
    { "type": "textarea", "id": "card3_body", "label": "Body", "default": "Refined styling and premium materials, built for everyday confidence and modern performance." }
  ]
}
{% endschema %}
