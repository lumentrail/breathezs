<section class="design" id="technology">
  <div class="container design-grid">
    <div>
      <h2 class="title">{{ section.settings.heading | default: 'Airflow,' }} <span class="accent">{{ section.settings.heading_accent | default: 'Engineered.' }}</span></h2>
      <p class="intro">{{ section.settings.intro | default: 'BreathEZs are medium length boxer briefs with a signature open rear for real ventilation. Full support up front. Free flowing air where you need it most. No elastic straps, no restriction, nothing like a jockstrap. Everything like relief.' }}</p>
      <ul>
        <li><span class="dot">◆</span><div><strong>{{ section.settings.item1_title | default: 'Natural Ventilation' }}</strong><span>{{ section.settings.item1_body | default: 'The open rear turns every step into airflow, keeping you cooler through the longest, hottest days.' }}</span></div></li>
        <li><span class="dot">◆</span><div><strong>{{ section.settings.item2_title | default: 'Full Support, Zero Restriction' }}</strong><span>{{ section.settings.item2_body | default: "Classic boxer brief support and coverage in front, without straps or elastic pressing where it shouldn't." }}</span></div></li>
        <li><span class="dot">◆</span><div><strong>{{ section.settings.item3_title | default: 'Discreet Under Anything' }}</strong><span>{{ section.settings.item3_body | default: "Tested under jeans and work pants. A smooth, low profile fit you'll barely notice." }}</span></div></li>
        <li><span class="dot">◆</span><div><strong>{{ section.settings.item4_title | default: 'Built for Real Work' }}</strong><span>{{ section.settings.item4_body | default: 'Made for warehouse crews, construction, mechanics, drivers, and athletes. Anyone who works up a sweat.' }}</span></div></li>
      </ul>
    </div>
    <div class="photo-frame infographic-frame">
      <img src="{% if section.settings.image %}{{ section.settings.image | image_url: width: 1100 }}{% else %}{{ 'bez-diagram.webp' | asset_url }}{% endif %}" loading="lazy" decoding="async" alt="BreathEZs infographic: engineered open-back airflow design">
    </div>
  </div>
  <div class="container comparison-embed">
    <img class="comparison-img"
         src="{% if section.settings.comparison_image %}{{ section.settings.comparison_image | image_url: width: 1049 }}{% else %}{{ 'jockstrap-vs.webp' | asset_url }}{% endif %}"
         alt="{{ section.settings.comparison_alt | default: 'How BreathEZs is different from a jockstrap: no elastic straps, an open rear for airflow, full coverage and support up front, and free airflow behind with zero restriction.' }}"
         loading="lazy" decoding="async" width="1049" height="1499">
    <div class="comparison-cta"><a href="{{ section.settings.comparison_cta_link | default: '#collection' }}" class="btn btn-primary">{{ section.settings.comparison_cta_label | default: 'Shop BreathEZs' }}</a></div>
  </div>
</section>

{% schema %}
{
  "name": "Airflow (Technology)",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Airflow," },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (purple)", "default": "Engineered." },
    { "type": "textarea", "id": "intro", "label": "Intro paragraph", "default": "BreathEZs are medium length boxer briefs with a signature open rear for real ventilation. Full support up front. Free flowing air where you need it most. No elastic straps, no restriction, nothing like a jockstrap. Everything like relief." },
    { "type": "image_picker", "id": "image", "label": "Infographic image", "info": "Leave empty to use the built-in diagram." },
    { "type": "header", "content": "Point 1" },
    { "type": "text", "id": "item1_title", "label": "Title", "default": "Natural Ventilation" },
    { "type": "textarea", "id": "item1_body", "label": "Body", "default": "The open rear turns every step into airflow, keeping you cooler through the longest, hottest days." },
    { "type": "header", "content": "Point 2" },
    { "type": "text", "id": "item2_title", "label": "Title", "default": "Full Support, Zero Restriction" },
    { "type": "textarea", "id": "item2_body", "label": "Body", "default": "Classic boxer brief support and coverage in front, without straps or elastic pressing where it shouldn't." },
    { "type": "header", "content": "Point 3" },
    { "type": "text", "id": "item3_title", "label": "Title", "default": "Discreet Under Anything" },
    { "type": "textarea", "id": "item3_body", "label": "Body", "default": "Tested under jeans and work pants. A smooth, low profile fit you'll barely notice." },
    { "type": "header", "content": "Point 4" },
    { "type": "text", "id": "item4_title", "label": "Title", "default": "Built for Real Work" },
    { "type": "textarea", "id": "item4_body", "label": "Body", "default": "Made for warehouse crews, construction, mechanics, drivers, and athletes. Anyone who works up a sweat." },
    { "type": "header", "content": "vs Jockstrap comparison graphic" },
    { "type": "image_picker", "id": "comparison_image", "label": "Comparison image", "info": "Leave empty to use the built-in vs-jockstrap graphic." },
    { "type": "text", "id": "comparison_alt", "label": "Comparison image alt text", "default": "How BreathEZs is different from a jockstrap: no elastic straps, an open rear for airflow, full coverage and support up front, and free airflow behind with zero restriction." },
    { "type": "text", "id": "comparison_cta_label", "label": "Button label", "default": "Shop BreathEZs" },
    { "type": "url", "id": "comparison_cta_link", "label": "Button link", "default": "/#collection" }
  ]
}
{% endschema %}
