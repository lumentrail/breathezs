<section class="comparison">
  <div class="container">
    <img class="comparison-img"
         src="{% if section.settings.image %}{{ section.settings.image | image_url: width: 1049 }}{% else %}{{ 'jockstrap-vs.webp' | asset_url }}{% endif %}"
         alt="{{ section.settings.alt | default: 'How BreathEZs is different from a jockstrap: no elastic straps, an open rear for airflow, full coverage and support up front, and free airflow behind with zero restriction.' }}"
         loading="lazy" decoding="async" width="1049" height="1499">
    {% if section.settings.show_cta %}
      <div class="comparison-cta">
        <a href="{{ section.settings.cta_link | default: '#collection' }}" class="btn btn-primary">{{ section.settings.cta_label | default: 'Shop BreathEZs' }}</a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Comparison graphic",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Leave empty to use the built-in vs-jockstrap graphic." },
    { "type": "text", "id": "alt", "label": "Image alt text", "default": "How BreathEZs is different from a jockstrap: no elastic straps, an open rear for airflow, full coverage and support up front, and free airflow behind with zero restriction." },
    { "type": "checkbox", "id": "show_cta", "label": "Show shop button below", "default": true },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop BreathEZs" },
    { "type": "url", "id": "cta_link", "label": "Button link", "default": "/#collection" }
  ],
  "presets": [ { "name": "Comparison graphic" } ]
}
{% endschema %}
