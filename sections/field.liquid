<section class="field">
  <div class="container">
    <h2 class="title">{{ section.settings.heading | default: "Proven Where It's" }} <span class="accent">{{ section.settings.heading_accent | default: 'Hot.' }}</span></h2>
    <div class="quotes">
      {% for block in section.blocks %}
      <blockquote class="quote" {{ block.shopify_attributes }}>
        <span class="mark">&ldquo;</span>
        <p>{{ block.settings.text }}</p>
        <footer>{{ block.settings.author }}</footer>
      </blockquote>
      {% endfor %}
      <blockquote class="quote quote-invite">
        <span class="mark" aria-hidden="true">&#10022;</span>
        <p>{{ section.settings.invite_text | default: 'This spot is reserved for you. Reserve a pair from the limited first run, be one of the first to wear BreathEZs, and tell us how cool you stayed.' }}</p>
        <footer><a href="#collection" style="text-decoration:underline">Shop now &rarr;</a></footer>
      </blockquote>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Proven Where It's" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (purple)", "default": "Hot." },
    { "type": "textarea", "id": "invite_text", "label": "Invite card text", "default": "This spot is reserved for you. Reserve a pair from the limited first run, be one of the first to wear BreathEZs, and tell us how cool you stayed." }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        { "type": "textarea", "id": "text", "label": "Quote", "default": "A great quote about BreathEZs." },
        { "type": "text", "id": "author", "label": "Attribution", "default": "Field tester" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "quote", "settings": { "text": "Coolest I have ever been.", "author": "Field tester" } }
      ]
    }
  ]
}
{% endschema %}
