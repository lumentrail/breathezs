<section class="field">
  <div class="container">
    <h2 class="title">{{ section.settings.heading | default: "Proven Where It's" }} <span class="accent">{{ section.settings.heading_accent | default: 'Hot.' }}</span></h2>
    <div class="quotes">
      <blockquote class="quote">
        <span class="mark">&ldquo;</span>
        <p>{{ section.settings.q1_text | default: 'Wore them under a full costume for an entire convention weekend. Coolest I have ever been at a con. I forgot ventilation like this was even possible.' }}</p>
        <footer>{{ section.settings.q1_author | default: 'Cosplay field tester' }}</footer>
      </blockquote>
      <blockquote class="quote">
        <span class="mark">&ldquo;</span>
        <p>{{ section.settings.q2_text | default: "I tried a pair on the job and haven't stopped thinking about them since. I keep asking every week when the 3XL is dropping." }}</p>
        <footer>{{ section.settings.q2_author | default: 'Warehouse crew tester' }}</footer>
      </blockquote>
      <blockquote class="quote quote-invite">
        <span class="mark" aria-hidden="true">&#10022;</span>
        <p>{{ section.settings.invite_text | default: 'This spot is reserved for you. Reserve a pair from the limited first run, be one of the first to wear BreathEZs, and tell us how cool you stayed.' }}</p>
        <footer><a href="#collection" style="text-decoration:underline">Shop now &rarr;</a></footer>
      </blockquote>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Proven Where It's" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (purple)", "default": "Hot." },
    { "type": "header", "content": "Quote 1" },
    { "type": "textarea", "id": "q1_text", "label": "Quote", "default": "Wore them under a full costume for an entire convention weekend. Coolest I have ever been at a con. I forgot ventilation like this was even possible." },
    { "type": "text", "id": "q1_author", "label": "Attribution", "default": "Cosplay field tester" },
    { "type": "header", "content": "Quote 2" },
    { "type": "textarea", "id": "q2_text", "label": "Quote", "default": "I tried a pair on the job and haven't stopped thinking about them since. I keep asking every week when the 3XL is dropping." },
    { "type": "text", "id": "q2_author", "label": "Attribution", "default": "Warehouse crew tester" },
    { "type": "header", "content": "Invite card" },
    { "type": "textarea", "id": "invite_text", "label": "Invite text", "default": "This spot is reserved for you. Reserve a pair from the limited first run, be one of the first to wear BreathEZs, and tell us how cool you stayed." }
  ]
}
{% endschema %}
