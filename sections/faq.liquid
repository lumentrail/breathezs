<section class="faq" id="faq">
  <div class="container">
    <h2 class="title">{{ section.settings.heading | default: 'Frequently Asked' }} <span class="accent">{{ section.settings.heading_accent | default: 'Questions.' }}</span></h2>
    <div class="faq-list">
      {% for block in section.blocks %}
      <details class="faq-item" {{ block.shopify_attributes }}>
        <summary>{{ block.settings.question }} <span class="plus">＋</span></summary>
        <div class="answer">{{ block.settings.answer }}</div>
      </details>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (purple)", "default": "Questions." }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Your question here?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Your answer here.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "item", "settings": { "question": "When do you launch?", "answer": "<p>We open with a soft launch in late August 2026, a limited first run with only a limited few made.</p>" } },
        { "type": "item", "settings": { "question": "Where can I buy them?", "answer": "<p>Right here on BreathEZs.com.</p>" } }
      ]
    }
  ]
}
{% endschema %}
